# Ten Kind Hands Frontend Configuration

# Backend API URL (default in development is http://localhost:5000/api; in production leave empty for relative /api or set your backend server URL)
VITE_API_BASE_URL=http://localhost:5000/api

# Paystack Public Key (e.g. pk_test_... or pk_live_...)
# When left empty, the Card/Online tab cleanly and honestly displays the "Coming Soon / Under Merchant Activation" notice
# and defaults donors to the active Providus Bank Transfer path.
# When provided, Paystack Inline payment checkout automatically activates.
VITE_PAYSTACK_PUBLIC_KEY=
